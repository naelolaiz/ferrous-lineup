# Maintainer: naelolaiz <naelolaiz@users.noreply.github.com>
pkgname=ferrous-lineup
pkgver=0.2.0
pkgrel=1
pkgdesc="Play songs with a backing band and learn harmony"
arch=('x86_64' 'aarch64')
url="https://github.com/naelolaiz/ferrous-lineup"
license=('GPL-3.0-or-later')
depends=(
  'alsa-lib'
  'desktop-file-utils'
  'hicolor-icon-theme'
  'libxkbcommon'
  'libxkbcommon-x11'
  'shared-mime-info'
  'wayland'
  'xdg-desktop-portal'
)
makedepends=('rust')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Run `updpkgsums` after the v$pkgver tag is pushed; GitHub's archive of a
# tag is not the same file as the working tree.
sha256sums=('d79c8fe49ac459d45338ba1d1c27bc71413bc43873c05dac354b594b9cfea319')

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 target/release/ferrous-lineup "$pkgdir/usr/bin/ferrous-lineup"
  install -Dm644 packaging/linux/io.github.naelolaiz.FerrousLineup.desktop \
    "$pkgdir/usr/share/applications/io.github.naelolaiz.FerrousLineup.desktop"
  install -Dm644 packaging/icon/ferrous-lineup.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.naelolaiz.FerrousLineup.svg"
  install -Dm644 packaging/linux/application-x-ferrous-lineup.xml \
    "$pkgdir/usr/share/mime/packages/application-x-ferrous-lineup.xml"
  install -Dm644 packaging/linux/io.github.naelolaiz.FerrousLineup.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.naelolaiz.FerrousLineup.metainfo.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
