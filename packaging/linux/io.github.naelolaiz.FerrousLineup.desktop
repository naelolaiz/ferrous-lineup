[Desktop Entry]
Type=Application
Name=Ferrous Lineup
GenericName=Backing band
Comment=Play songs with a backing band and learn harmony
Exec=ferrous-lineup %f
TryExec=ferrous-lineup
Icon=io.github.naelolaiz.FerrousLineup
Terminal=false
Categories=AudioVideo;Audio;Music;
Keywords=music;band;chords;harmony;sequencer;MIDI;backing track;
MimeType=application/x-ferrous-lineup;
StartupNotify=true
StartupWMClass=ferrous-lineup
